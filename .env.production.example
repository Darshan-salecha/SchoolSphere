# ---------------------------------------------------------------------------
# SchoolSphere production environment
#
#   cp .env.production.example .env.production
#   then fill in every value marked CHANGE-ME
#
# Docker Compose reads this file automatically when you pass --env-file.
# Never commit the filled-in copy.
# ---------------------------------------------------------------------------

# Public hostname — no scheme, no trailing slash, no port.
APP_DOMAIN=school.example.com
APP_URL=https://school.example.com

# TLS -----------------------------------------------------------------------
# Substituted into the Caddyfile verbatim.
#
#   (empty)      Automatic Let's Encrypt. Needs APP_DOMAIN to be a real name
#                that resolves to this server, with ports 80 and 443 open.
#   tls internal Caddy signs the certificate with its own local CA. Use this
#                when APP_DOMAIN is an IP-derived name such as
#                169-58-175-152.sslip.io, where Let's Encrypt issuance is
#                unreliable. Browsers show a one-time "not private" warning
#                that the visitor has to click through.
CADDY_TLS_DIRECTIVE=

# Only send HSTS once you have a real certificate. A browser that has seen this
# header refuses plain http for the whole max-age, which is painful to undo
# while you are still moving the site around.
CADDY_HSTS_HEADER=Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Host ports ----------------------------------------------------------------
# SchoolSphere owns the 8100-8199 block on this machine. See PORTS.md.
# 80 and 443 belong to Caddy and to nothing else — leave them alone.
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
# Loopback-only debugging door: curl http://127.0.0.1:8100/api/health
APP_HOST_PORT=8100

# Database ------------------------------------------------------------------
POSTGRES_USER=schoolsphere
POSTGRES_DB=schoolsphere
# CHANGE-ME: openssl rand -base64 24
POSTGRES_PASSWORD=

# Host `db` is the compose service name. Point this at your managed Postgres
# instead if you are not running the bundled database.
DATABASE_URL=postgresql://schoolsphere:CHANGE-ME@db:5432/schoolsphere

# Set to true when your managed provider requires TLS (RDS, Neon, Supabase).
DATABASE_SSL=false

# Security ------------------------------------------------------------------
# CHANGE-ME: openssl rand -hex 32
AUTH_SECRET=

# Integrations --------------------------------------------------------------
# `mock` writes to the container log instead of contacting a real provider.
# Parents cannot receive real OTP codes until SMS_PROVIDER is a real driver.
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
PAYMENT_PROVIDER=mock

# `local` stores uploads on the mounted volume — fine for a single instance.
# Switch to an object-store driver before scaling past one app container.
STORAGE_PROVIDER=local
